#!/bin/sh

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")

if [ "$branch" = "main" ] && [ "${GROUNDWORK_ALLOW_MAIN_COMMIT:-}" != "1" ]; then
	echo ""
	echo "  Refusing to commit on main."
	echo ""
	echo "  Work reaches everyone through main, so it lands through a branch"
	echo "  and a pull request:"
	echo ""
	echo "      git checkout -b <type>/<topic>"
	echo "      git commit …"
	echo "      git push -u origin <type>/<topic>"
	echo "      gh pr create --base main"
	echo ""
	echo "  If you genuinely mean to commit on main:"
	echo ""
	echo "      GROUNDWORK_ALLOW_MAIN_COMMIT=1 git commit …"
	echo ""
	exit 1
fi

if [ "${GROUNDWORK_ALLOW_COMMENTS:-}" = "1" ]; then
	exit 0
fi

PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
if ! command -v node >/dev/null 2>&1; then
	echo "  node was not found, so the staged diff was not checked for comments."
	exit 0
fi

violations=$(node "$(git rev-parse --show-toplevel)/.claude/hooks/lib/comments.mjs")

if [ -n "$violations" ]; then
	echo ""
	echo "  The staged diff adds comments to code files, which this repo does not allow."
	echo ""
	echo "$violations" | head -20
	echo ""
	echo "  Only toolchain directives naming their rule are allowed. Move the"
	echo "  explanation into a name, a constant, a test, README.md or HANDOVER.md."
	echo ""
	echo "  If you genuinely mean to keep them:"
	echo ""
	echo "      GROUNDWORK_ALLOW_COMMENTS=1 git commit …"
	echo ""
	exit 1
fi

exit 0
